digraph UML { graph [rankdir=TB,bgcolor="white",pad=0.25,nodesep=0.4,ranksep=0.72,splines=polyline]; node [shape=plaintext,fontname="DejaVu Sans"]; edge [color="#536276",fontname="DejaVu Sans",fontsize=9,arrowsize=0.65];
"BookingPricingStrategy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>BookingPricingStrategy</B></FONT><BR/><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ getName(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ calculate(cost: double): double</FONT></TD></TR></TABLE>>];
"StandardBookingPricing" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>StandardBookingPricing</B></FONT><BR/><FONT POINT-SIZE="9">Concrete Strategy</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ calculate(cost): double</FONT></TD></TR></TABLE>>];
"StudentBookingPricing" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>StudentBookingPricing</B></FONT><BR/><FONT POINT-SIZE="9">Concrete Strategy</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ calculate(cost): double</FONT></TD></TR></TABLE>>];
"BookingPricingContext" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>BookingPricingContext</B></FONT><BR/><FONT POINT-SIZE="9">Context</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- strategy: BookingPricingStrategy</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ setStrategy(strategy): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ calculatePrice(booking): double</FONT></TD></TR></TABLE>>];
"StandardBookingPricing" -> "BookingPricingStrategy" [arrowhead=empty,style=dashed];"StudentBookingPricing" -> "BookingPricingStrategy" [arrowhead=empty,style=dashed];"BookingPricingContext" -> "BookingPricingStrategy" [label="strategy",arrowhead=vee];}
