digraph UML { graph [rankdir=TB,bgcolor="white",pad=0.25,nodesep=0.4,ranksep=0.72,splines=polyline]; node [shape=plaintext,fontname="DejaVu Sans"]; edge [color="#536276",fontname="DejaVu Sans",fontsize=9,arrowsize=0.65];
"BookingObserver" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>BookingObserver</B></FONT><BR/><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ onBookingEvent(event): void</FONT></TD></TR></TABLE>>];
"ConsoleBookingObserver" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>ConsoleBookingObserver</B></FONT><BR/><FONT POINT-SIZE="9">Concrete Observer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ onBookingEvent(event): void</FONT></TD></TR></TABLE>>];
"BookingHistoryObserver" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>BookingHistoryObserver</B></FONT><BR/><FONT POINT-SIZE="9">Concrete Observer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- events: List&lt;BookingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ onBookingEvent(event): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ getEvents(): List</FONT></TD></TR></TABLE>>];
"TripManager" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>TripManager</B></FONT><BR/><FONT POINT-SIZE="9">Subject / Singleton</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- observers: List&lt;BookingObserver&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ addObserver(observer): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ removeObserver(observer): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- notifyObservers(event): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ addBooking(booking): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ removeBooking(booking): boolean</FONT></TD></TR></TABLE>>];
"BookingEvent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>BookingEvent</B></FONT><BR/><FONT POINT-SIZE="9">Event record</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ type: BookingEventType</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ booking: TripBooking</FONT></TD></TR></TABLE>>];
"ConsoleBookingObserver" -> "BookingObserver" [arrowhead=empty,style=dashed];"BookingHistoryObserver" -> "BookingObserver" [arrowhead=empty,style=dashed];"TripManager" -> "BookingObserver" [arrowhead=odiamond,label="subscribers"];"TripManager" -> "BookingEvent" [style=dashed,label="creates",arrowhead=vee];}
