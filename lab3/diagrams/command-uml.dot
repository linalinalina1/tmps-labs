digraph UML { graph [rankdir=TB,bgcolor="white",pad=0.25,nodesep=0.4,ranksep=0.72,splines=polyline]; node [shape=plaintext,fontname="DejaVu Sans"]; edge [color="#536276",fontname="DejaVu Sans",fontsize=9,arrowsize=0.65];
"BookingCommand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>BookingCommand</B></FONT><BR/><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ execute(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ undo(): void</FONT></TD></TR></TABLE>>];
"CreateBookingCommand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>CreateBookingCommand</B></FONT><BR/><FONT POINT-SIZE="9">Concrete Command</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- tripManager: TripManager</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- booking: TripBooking</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- executed: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ execute(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ undo(): void</FONT></TD></TR></TABLE>>];
"BookingCommandInvoker" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>BookingCommandInvoker</B></FONT><BR/><FONT POINT-SIZE="9">Invoker</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- history: Deque&lt;BookingCommand&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ execute(command): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ undoLast(): boolean</FONT></TD></TR></TABLE>>];
"TripManager" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>TripManager</B></FONT><BR/><FONT POINT-SIZE="9">Receiver / Observer Subject</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ addBooking(booking): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ removeBooking(booking): boolean</FONT></TD></TR></TABLE>>];
"TravelPlannerFacade" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748B"><TR><TD BGCOLOR="#E8EEF8" ALIGN="CENTER"><FONT POINT-SIZE="12"><B>TravelPlannerFacade</B></FONT><BR/><FONT POINT-SIZE="9">Client</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ createTrip(...): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">+ undoLastBooking(): boolean</FONT></TD></TR></TABLE>>];
"CreateBookingCommand" -> "BookingCommand" [arrowhead=empty,style=dashed];"BookingCommandInvoker" -> "BookingCommand" [arrowhead=odiamond,label="history"];"CreateBookingCommand" -> "TripManager" [label="receiver",arrowhead=vee];"TravelPlannerFacade" -> "BookingCommandInvoker" [label="uses",arrowhead=vee];"TravelPlannerFacade" -> "CreateBookingCommand" [style=dashed,label="creates",arrowhead=vee];}
